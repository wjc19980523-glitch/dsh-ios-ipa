#!/bin/sh
# Launch the DeepSeek Harness web UI inside the DSH iOS app's Linux guest.
#
# The iOS app runs this as the supervised foreground process and points its
# WKWebView at http://127.0.0.1:$DSH_PORT once the server answers.
#
#   DSH_PORT       listen port (default 3080)
#   DSH_WORKSPACE  initial working directory offered as the workspace
#   DSH_HOME       harness home (default /root/.dsh)
#   DSH_LOCALE     GUI language to select on first run (default zh)
export HOME=/root
export DSH_HOME="${DSH_HOME:-/root/.dsh}"
export DSH_WORKSPACE="${DSH_WORKSPACE:-/root/workspace}"
PORT="${DSH_PORT:-3080}"
LOCALE_DEFAULT="${DSH_LOCALE:-zh}"

mkdir -p "$DSH_WORKSPACE"

# ---------------------------------------------------------------------------
# Patch layers.
#
# Two different files with two different owners live under $DSH_HOME, and
# conflating them is what this block exists to avoid:
#
#   $DSH_HOME/cordis.patch.yml                    (home layer, ours)
#   $DSH_HOME/profiles/web/cordis.patch.yml       (profile layer, SHARED)
#
# The home layer is purely ours: it only registers the host-bridge plugin, so
# the image can rewrite it on every start and a migrated home from an older
# image cannot pin a stale copy.
#
# The profile layer is NOT purely ours. Since dsh 0.2.x the GUI writes the
# user's language choice into exactly this file, so overwriting it on every boot
# would reset the language each launch. It is written once, when absent, and
# then owned by the user; DSH_FORCE_PATCH=1 restores the shipped version if a
# bad edit ever breaks the profile. A broken profile fails loudly at boot, and
# `dsh --profile web --dump-config` is the recovery diagnostic.
# ---------------------------------------------------------------------------
mkdir -p "$DSH_HOME"
install -m 0644 /usr/local/share/dsh/home.patch.yml "$DSH_HOME/cordis.patch.yml"

PROFILE_DIR="$DSH_HOME/profiles/web"
mkdir -p "$PROFILE_DIR"
if [ ! -f "$PROFILE_DIR/cordis.patch.yml" ] || [ "${DSH_FORCE_PATCH:-0}" = "1" ]; then
    install -m 0644 /usr/local/share/dsh/cordis.patch.yml "$PROFILE_DIR/cordis.patch.yml"
    # Seed the language with the shipped default; an existing file keeps
    # whatever the user or the GUI already chose.
    if [ -n "$LOCALE_DEFAULT" ]; then
        cat >> "$PROFILE_DIR/cordis.patch.yml" <<EOF

# Set by dsh-serve when the profile was first created. Changing the language in
# Settings rewrites this section; delete it to fall back to the browser's.
- id: locale
  config:
    preference: $LOCALE_DEFAULT
EOF
    fi
fi

cd "$DSH_WORKSPACE"

# --expose-internals: cordis-plugin-hmr needs Node internals; the prebuilt
# node-addon-require-builtin shim has no musl build, so use the flag instead.
#
# --no-open: dsh would otherwise try to launch a "default browser" inside the
# guest, which has no desktop session and nothing to launch. The app points its
# own WKWebView at the URL dsh prints.
exec node --expose-internals \
    /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
    web --host 127.0.0.1 --port "$PORT" --no-open "$@"
