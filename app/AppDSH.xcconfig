// DSH — DeepSeek Harness for iPad/iPhone.
// Builds the iSH-ARM64 emulator (./ish-arm64) with a WKWebView front end and
// a bundled Alpine + Node + dsh root filesystem (build/root.tar.gz).
// SRCROOT is the repo root; ISH_SRC points at the emulator sources.
#include "../ish-arm64/app/AppARM64.xcconfig"

ISH_SRC = $(SRCROOT)/ish-arm64

PRODUCT_NAME = DSH
DSH_BUNDLE_ID_PREFIX = com.xnuapp
PRODUCT_BUNDLE_IDENTIFIER = $(DSH_BUNDLE_ID_PREFIX).dsh
PRODUCT_APP_GROUP_IDENTIFIER = group.$(DSH_BUNDLE_ID_PREFIX).dsh

MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 23

INFOPLIST_FILE = $(SRCROOT)/app/Info.plist
INFOPLIST_PREPROCESS = NO
INFOPLIST_PREFIX_HEADER =
CODE_SIGN_ENTITLEMENTS = $(SRCROOT)/app/DSH.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = DSHAppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = DSHAccent

IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO

// Signing: automatic; pass DSH_DEVELOPMENT_TEAM=XXXXXXXXXX to xcodebuild or
// set it here for local builds. The wildcard team profile is enough — the app
// declares no special entitlements.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(DSH_DEVELOPMENT_TEAM)

// Guest image produced by scripts/build-rootfs.sh, bundled as root.tar.gz.
DSH_ROOTFS_TARBALL = $(SRCROOT)/build/root.tar.gz

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DSH_APP=1
HEADER_SEARCH_PATHS = $(ISH_SRC) $(ISH_SRC)/app $(ISH_SRC)/deps/libarchive/libarchive $(SRCROOT)/app

// The AArch64 gadgets are host arm64 assembly: only Apple Silicon simulators
// can run the emulator, so never build x86_64 slices.
ARCHS[sdk=iphonesimulator*] = arm64
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64 i386

// DSHTests links against DSH.app/DSH through -bundle_loader, so it can only
// reach symbols the executable exports. On iOS an executable exports no plain C
// globals at all unless asked, and GCC_SYMBOLS_PRIVATE_EXTERN only relaxes that
// for Objective-C classes. Each entry below was an "Undefined symbols for
// architecture arm64" link failure, reported *after* every source file had
// compiled cleanly -- which is what makes this class of mistake expensive.
//
// The list is exactly the C symbols the tests read, no more:
//   DSHHarnessTokenQueryKey / DSHHarnessAuthCookiePrefix  handshake protocol facts
//   DSHDisplayValue        the text sanitiser DSHDisplayValueTests exercises
//   DSHHarnessStateName    maps state to a name, asserted verbatim
//   ...StateDidChangeNotification, ...LogBufferDidChangeNotification,
//   ...TurnWasInterruptedNotification   the tests observe these by name
//
// Every symbol must also be marked DSH_EXPORTED where it is declared, or it
// stays hidden and this list has nothing to name. Adding a symbol here without
// that attribute silently does nothing.
//
// One OTHER_LDFLAGS line: a second assignment would discard the first, taking
// the framework list with it.
GCC_SYMBOLS_PRIVATE_EXTERN = NO
OTHER_LDFLAGS = $(inherited) -framework WebKit -framework EventKit -framework HealthKit -framework Contacts -framework UserNotifications -framework UniformTypeIdentifiers -framework PhotosUI -framework Photos -Wl,-exported_symbol,_DSHHarnessTokenQueryKey -Wl,-exported_symbol,_DSHHarnessAuthCookiePrefix -Wl,-exported_symbol,_DSHDisplayValue -Wl,-exported_symbol,_DSHHarnessStateName -Wl,-exported_symbol,_DSHHarnessStateDidChangeNotification -Wl,-exported_symbol,_DSHLogBufferDidChangeNotification -Wl,-exported_symbol,_DSHTurnWasInterruptedNotification
