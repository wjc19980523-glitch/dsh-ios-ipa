<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DSHIOS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- The bundled harness serves its web UI in plain HTTP on a loopback
			     port only this app chooses. ATS grants no implicit exemption to
			     numeric loopback addresses, and dsh 0.2.x puts its launch token
			     in the URL of the redirect it uses to set the auth cookie, so
			     the exchange has to survive as written. Scoped to the loopback
			     literal and nothing else: no wildcard, no other host. -->
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DSH lets the agent read your calendar when you turn the Calendar capability on.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>DSH lets the agent read your calendar when you turn the Calendar capability on.</string>
	<key>NSContactsUsageDescription</key>
	<string>DSH looks up contacts by name when you ask the agent about someone, and only after you switch Contacts on in DSH ▸ Capabilities.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>DSH can read your Health data — steps, heart rate, sleep and workouts — only after you switch Apple Health on in DSH ▸ Capabilities, and only to answer what you ask the agent.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>DSH never writes to Apple Health. It only reads, and only after you switch Apple Health on in DSH ▸ Capabilities. This description is required because the app links HealthKit.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DSH runs a local web server inside the app and connects to it over loopback.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DSH uses your location only while you are using the app, when the agent needs it for something you asked and after you switch Location on in DSH ▸ Capabilities. DSH does not track your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DSH asks for your location only when the agent needs it for something you asked, and only after you switch Location on in DSH ▸ Capabilities. It never tracks you in the background.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>DSH lets the agent read your reminders when you turn the Reminders capability on.</string>
	<key>NSRemindersUsageDescription</key>
	<string>DSH lets the agent read your reminders when you turn the Reminders capability on.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Main App</string>
					<key>UISceneDelegateClassName</key>
					<string>DSHSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>DSHLaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
